__pycache__/
*.py[cod]
.venv/
venv/
.env
*.db
*.log
.pytest_cache/
node_modules/
dist/
screenshots/
vite.log
vite.err
.DS_Store

# Editable-install metadata, created by `pip install -e .\backend[dev]`.
*.egg-info/

# Local dev runtime state written by scripts\dev.ps1: logs and pid files.
.dev/

# Rust / Tauri build output. src-tauri\src, Cargo.toml, tauri.conf.json,
# capabilities\ and icons\ are all source and are committed.
#
# Cargo.lock is deliberately NOT ignored: this crate is an application, not a
# library, so its exact dependency versions are what make a build reproducible.
src-tauri/target/
src-tauri/gen/

# Tauri bundle output.
*.msi

# Backend / Alembic / database test artefacts.
# .pgtest is a throwaway local PostgreSQL cluster used when Docker is
# unavailable; its data directory must never be committed.
.pgtest/
*.db-journal
*.db-wal
*.db-shm
# Managed checkouts for GitHub repository sources (SOURCE_CHECKOUT_ROOT)
gaia_source_checkouts/
# Where Apollo keeps documents dropped in on the inbox (APOLLO_STORAGE_ROOT).
# The reader's own documents, never committed: the application keeps them here
# precisely so a Git repository is not the place a copy of their desk ends up.
backend/apollo_storage/
# Local embedding model weights (LLAMACPP_MODELS_DIR). Multi-gigabyte downloads
# the app fetches; they are reproducible from the catalog and must never be
# committed.
backend/models/
*.gguf
*.gguf.part

# Scratch repositories the smoke scripts create and move documents around in.
# They are throwaway, and a file a test moved must never look like a change to
# the project.
.smoke-*/

# Scratch logs written while running a server or a test by hand. Named with a
# leading underscore so they cannot be confused with a real output file.
_*.out
_*.err
_*.tmp
