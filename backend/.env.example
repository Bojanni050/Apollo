# =============================================================================
# Gaia Docs Architect -- configuration
# =============================================================================
# Copy to .env and adjust. NEVER commit a filled-in .env: it holds secrets.
# .env is already in .gitignore.
#
# Two modes exist, and they behave very differently:
#
#   APP_ENV=development  Local work. Authentication and the workspace-root
#                        restriction can be switched off EXPLICITLY below.
#                        Never use this for anything reachable by a network.
#
#   APP_ENV=production   The DEFAULT. Authentication is mandatory, at least one
#                        workspace root is mandatory, and CORS origins must be
#                        listed explicitly. A production configuration missing
#                        any of these REFUSES TO START.
#
# Generate the two secrets a production deployment needs:
#   python -m app.security hash-password      # -> AUTH_PASSWORD_HASH
#   python -m app.security generate-secret    # -> SESSION_SECRET
# =============================================================================

# --- Mode -------------------------------------------------------------------
# Leave this as "production" unless you are working locally. The value is
# validated: anything other than development/production is a startup error.
APP_ENV=production

# --- Database (PostgreSQL in production) ----------------------------------
# The full connection URL. NEVER hardcode a password in source control: supply
# this from the environment or a secret manager. It is the single source of
# truth for the application AND for Alembic (alembic.ini has no sqlalchemy.url,
# so a stale URL there cannot send a migration to the wrong database).
DATABASE_URL=postgresql+psycopg://gaia:CHANGE_ME@localhost:5432/gaia_docs

# Apply pending migrations during application startup. Leave FALSE in
# production: with it off, the server verifies the schema at boot and refuses
# to start if it is behind (run `alembic upgrade head` as a deployment step).
# With it on, two instances booting at once could race each other.
DB_MIGRATE_ON_STARTUP=false

# Refuse to start in production if DATABASE_URL is not PostgreSQL. SQLite is a
# local-development convenience and is not a production store.
DB_REQUIRE_POSTGRES_IN_PRODUCTION=true

# =============================================================================
# AUTHENTICATION  (required in production)
# =============================================================================
# A single local account. There is no registration and no password reset: the
# operator who deploys the app is the user.

# Master switch. Setting this to false is only honoured when
# APP_ENV=development; in production the server refuses to start.
AUTH_ENABLED=true

AUTH_USERNAME=admin

# Preferred. Generate with: python -m app.security hash-password
AUTH_PASSWORD_HASH=

# Alternative to the hash above, for local convenience only. Anyone who can read
# the process environment can read this, so prefer AUTH_PASSWORD_HASH.
AUTH_PASSWORD=

# Signs the session cookie. Required in production, minimum 32 characters.
# Generate with: python -m app.security generate-secret
SESSION_SECRET=

# Optional long-lived bearer token for CLI use and smoke scripts:
#   curl -H "Authorization: Bearer $AUTH_API_TOKEN" localhost:8000/api/workspaces
# Leave empty to disable bearer tokens entirely.
AUTH_API_TOKEN=

# Session lifetime in seconds (default 12 hours).
SESSION_MAX_AGE_SECONDS=43200

# Cookie name. Change only if something else on the origin needs the name.
AUTH_COOKIE_NAME=gaia_session

# Leave empty to let the app decide: Secure is ON in production, OFF in
# development (where you are typically on plain http://localhost).
# AUTH_COOKIE_SECURE=

# =============================================================================
# CORS  (origins must be explicit in production)
# =============================================================================
# Exact origins allowed to call the API from a browser. In development an empty
# value falls back to the Vite dev server (http://localhost:5173 and
# http://127.0.0.1:5173). In production an empty value is a startup error.
#
# "*" is REJECTED in production: with credentials enabled it would let any
# website on the internet make authenticated requests against this API.
# Note the Vite dev server proxies /api, so same-origin dev usually needs
# nothing here at all.
CORS_ORIGINS=[]

# The session cookie must be sent, so credentialed requests are allowed.
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# WORKSPACE ROOTS  (at least one required in production)
# =============================================================================
# Directories that may be registered as workspace repositories. Any repository
# path outside every one of these roots is rejected, after resolution -- so ".."
# segments and symlinks pointing out of the tree do not get through.
#
# An EMPTY LIST MEANS "NOTHING CAN BE REGISTERED" in production. It no longer
# means "any directory", which used to let the API read arbitrary paths on the
# host.
ALLOWED_WORKSPACE_ROOTS=["C:/src/gaia-docs"]

# Development-only escape hatch: treat an empty root list as "any existing
# directory". Ignored in production, where setting it is a startup error.
ALLOW_UNRESTRICTED_WORKSPACE_ROOTS=false

# --- Repository sources (architecture evidence) -----------------------------
# Root under which GitHub repository sources are cloned/pulled. Machine-specific
# by design: never portable, and deliberately NOT part of .sources.yaml, which
# only describes source identity and location. GitHub credentials are never
# stored anywhere -- private repositories are not supported in this milestone.
SOURCE_CHECKOUT_ROOT=./gaia_source_checkouts

# --- Semantic indexing (embeddings + pgvector) ------------------------------
# Model names are configuration. Changing either one makes the existing
# vectors incompatible; the application detects that (chunk rows carry their
# model and dimensions) and requires a controlled re-index.
#   CODE_EMBEDDING_MODEL: Jina Code Embeddings 1.5B -- source code (supports
#   natural-language -> code retrieval).
#   DOCUMENT_EMBEDDING_MODEL: BAAI/bge-m3 -- Markdown, ADRs, architecture docs.
CODE_EMBEDDING_MODEL=jina-code-embeddings-1.5b
DOCUMENT_EMBEDDING_MODEL=BAAI/bge-m3
# Texts embedded per provider call.
EMBEDDING_BATCH_SIZE=32
# Default result limit for vector/semantic searches.
VECTOR_SEARCH_LIMIT=5
# Optional remote embedding API (OpenAI-compatible /embeddings endpoint or a
# Jina-style endpoint). When EMBEDDING_API_BASE_URL is unset, a deterministic
# local fallback provider is used, so no paid external API is required.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# --- LLM provider (OpenAI-compatible) ---------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# LLM_CONTEXT_TOKENS is the TOTAL context window of the model named in
# LLM_MODEL, in tokens: the ceiling for input AND output combined, exactly as
# the vendor states it. It is enforced, not advisory -- the application reserves
# space for the reply and fits everything else (system prompt, tool definitions,
# conversation history, tool results, retrieved documents) into the remainder.
# Accepted range: 1024 to 4,000,000. Set it to match your real model: too large
# and oversized requests fail at the provider, too small and history is
# discarded needlessly.
LLM_CONTEXT_TOKENS=128000

# Reserved from the context window for the model's reply. Subtracted from
# LLM_CONTEXT_TOKENS before anything else is budgeted, so it must be smaller
# than the window. Minimum 256.
LLM_MAX_OUTPUT_TOKENS=8192

LLM_TEMPERATURE=0.2
