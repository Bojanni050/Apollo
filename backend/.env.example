# Copy to .env and adjust. Never commit real keys.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://gaia:gaia@localhost:5432/gaia_docs

# --- Server ---
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Safety ---
# Directories that may be registered as workspace repositories. Leave empty to
# allow any existing local path (convenient in development). Set this in
# production so repository access is restricted to your documentation tree.
ALLOWED_WORKSPACE_ROOTS=[]

# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_TOKENS=128000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
